# Copy this file to ".env" and fill in your values.
# NEVER commit .env to git or share it - it contains secrets.

# ---------------- Shopify ----------------
# Your store's myshopify domain (no https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option A (recommended, new Dev Dashboard apps): Client ID + Secret.
# The tool exchanges these for a 24-hour access token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option B (older "custom apps" made in the store admin): a permanent
# Admin API token that starts with "shpat_". If set, Option A is ignored.
SHOPIFY_ACCESS_TOKEN=

# Shopify Admin API version (change it if Shopify retires this one)
SHOPIFY_API_VERSION=2026-07

# ---------------- AI (all free options) ----------------
# Which provider to use: gemini | groq
AI_PROVIDER=gemini

# Google Gemini - free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq - free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the provider's default model
# (defaults: gemini-flash-lite-latest / llama-3.3-70b-versatile)
AI_MODEL=

# Seconds to wait between products, to stay inside free-tier rate limits
AI_DELAY_SECONDS=5

# Optional: a sentence about your brand so the AI matches your voice
# e.g. "Handmade eco-friendly candles. Warm, friendly tone. UK spelling."
STORE_CONTEXT=

# Version 2: double-check AI text for guesses (1 extra AI call per item)
GUESS_CHECK=true

# ---------------- Output ----------------
CSV_PATH=seo_results.csv
COLLECTIONS_CSV_PATH=collection_results.csv
IMAGES_CSV_PATH=alt_text_results.csv

# ---------------- Website ----------------
# Port (change if 8001 is used by another program)
PORT=8001

# Leave these as they are on your own PC: no login needed, only you can open it.
# When the website is ONLINE (e.g. on Render), set:
#   HOST=0.0.0.0          -> listen for visitors from the internet
#   ADMIN_PASSWORD=...    -> your owner password (long and unique!)
#   PUBLIC_DEMO=true      -> visitors may browse results read-only + use the demo chat
#   SESSION_SECRET=...    -> any long random text (keeps you logged in after restarts)
HOST=127.0.0.1
ADMIN_PASSWORD=
PUBLIC_DEMO=false
SESSION_SECRET=

# ---------------- Version 3: client stores ----------------
# The address of this website. Shopify sends client stores back here after they
# approve the app. Leave empty on your PC; online, e.g. https://my-seo-tool.onrender.com
PUBLIC_URL=
# What the app may do on client stores (must match the app's scopes in the Dev Dashboard)
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files
